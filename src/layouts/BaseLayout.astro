---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Special Day ✨" } = Astro.props;
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>{title}</title>
  </head>
  <body class="m-0 h-screen w-screen overflow-hidden bg-neutral-950 text-white select-none">
    <slot />
  </body>
</html>