---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrientationOverlay from '../components/OrientationOverlay.astro';
import ParticleScene from '../components/ParticleScene.astro';
---

<BaseLayout title="Happy Birthday ✨">
  <OrientationOverlay />
  <ParticleScene />

  <!-- Area UI sementara di atas canvas -->
  <main class="relative z-10 flex h-full w-full flex-col items-center justify-center pointer-events-none">
    <p class="mt-24 text-sm tracking-[0.25em] text-pink-200/80 uppercase animate-pulse">
      Loading Magic...
    </p>
  </main>
</BaseLayout>